{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Hotter Years, More Intense Burns — Temp Anomaly vs CO₂ per Hectare",
    "color": "#f5e6d3",
    "fontSize": 16
  },
  "width": 860,
  "height": 350,
  "background": "#1a0a02",
  "data": {"url": "data/co2_emissions.csv"},
  "transform": [
    {"filter": "datum.Entity == 'Australia'"},
    {"filter": "toNumber(datum.Year) >= 2012 && toNumber(datum.Year) <= 2025"},
    {
      "lookup": "Year",
      "from": {
        "data": {"url": "data/area_burnt.csv"},
        "key": "Year",
        "fields": ["Annual area burnt by wildfires"]
      }
    },
    {
      "lookup": "Year",
      "from": {
        "data": {"url": "data/bom_temperature.csv"},
        "key": "Year",
        "fields": ["Anomaly"]
      }
    },
    {
      "calculate": "datum['Annual carbon dioxide emissions'] / datum['Annual area burnt by wildfires']",
      "as": "co2_per_ha"
    }
  ],
  "layer": [
    {
      "mark": {"type": "circle", "size": 150, "opacity": 0.9, "tooltip": true},
      "encoding": {
        "x": {
          "field": "Anomaly",
          "type": "quantitative",
          "title": "Temperature Anomaly (°C)",
          "axis": {"labelColor": "#c8a882", "titleColor": "#c8a882", "gridColor": "#2d1208", "labelFontSize": 12, "titleFontSize": 13}
        },
        "y": {
          "field": "co2_per_ha",
          "type": "quantitative",
          "title": "CO₂ per Hectare Burnt (tonnes/ha)",
          "axis": {"labelColor": "#c8a882", "titleColor": "#c8a882", "gridColor": "#2d1208", "labelFontSize": 12, "titleFontSize": 13}
        },
        "color": {
          "field": "Anomaly",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [0.5, 1.0, 1.5],
            "range": ["#3d0a00", "#7a3010", "#e05c00", "#ff6b35"]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "Year", "type": "ordinal", "title": "Year"},
          {"field": "Anomaly", "type": "quantitative", "title": "Temp Anomaly (°C)", "format": ".2f"},
          {"field": "co2_per_ha", "type": "quantitative", "title": "CO₂/ha (t/ha)", "format": ".2f"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#ff9a56"
      },
      "encoding": {
        "x": {"field": "Anomaly", "type": "quantitative"},
        "y": {"field": "co2_per_ha", "type": "quantitative"},
        "text": {"field": "Year", "type": "ordinal"}
      }
    }
  ],
  "config": {
    "background": "#1a0a02",
    "view": {"stroke": "transparent"}
  }
}