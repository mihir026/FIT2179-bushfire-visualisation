{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Annual Number of Fires in Australia",
  "width": 400,
  "height": 300,
  "data": {"url": "data/num_fires.csv"},
  "transform": [
    {"filter": "datum.Entity == 'Australia'"},
    {"filter": "toNumber(datum.Year) >= 2012 && toNumber(datum.Year) <= 2025"}
  ],
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": "Year"
    },
    "y": {
      "field": "Annual number of fires",
      "type": "quantitative",
      "title": "Number of Fires"
    }
  }
}