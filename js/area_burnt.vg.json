{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Annual Area Burnt by Wildfires in Australia",
  "width": 400,
  "height": 300,
  "data": {"url": "data/area_burnt.csv"},
  "transform": [
    {"filter": "datum.Entity == 'Australia'"},
    {"filter": "datum.Year >= 2012 && datum.Year <= 2025"}
  ],
  "mark": "line",
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": "Year"
    },
    "y": {
      "field": "Annual area burnt by wildfires",
      "type": "quantitative",
      "title": "Area Burnt (hectares)"
    }
  }
}