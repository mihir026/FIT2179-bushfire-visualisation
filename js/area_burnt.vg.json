{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Annual Area Burnt by Wildfires in Australia (2012–2025)",
    "color": "#f5e6d3",
    "fontSize": 16
  },
  "width": 860,
  "height": 350,
  "background": "#1a0a02",
  "data": {"url": "data/area_burnt.csv"},
  "transform": [
    {"filter": "datum.Entity == 'Australia'"},
    {"filter": "toNumber(datum.Year) >= 2012 && toNumber(datum.Year) <= 2025"}
  ],
  "layer": [
    {
      "mark": {
        "type": "area",
        "color": "#e05c00",
        "opacity": 0.4,
        "line": {"color": "#ff6b35", "strokeWidth": 2}
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "title": "Year",
          "axis": {"labelColor": "#c8a882", "titleColor": "#c8a882", "gridColor": "#2d1208", "labelFontSize": 12, "titleFontSize": 13}
        },
        "y": {
          "field": "Annual area burnt by wildfires",
          "type": "quantitative",
          "title": "Area Burnt (hectares)",
          "axis": {"labelColor": "#c8a882", "titleColor": "#c8a882", "gridColor": "#2d1208", "labelFontSize": 12, "titleFontSize": 13}
        },
        "tooltip": [
          {"field": "Year", "type": "ordinal", "title": "Year"},
          {"field": "Annual area burnt by wildfires", "type": "quantitative", "title": "Area Burnt (ha)", "format": ","}
        ]
      }
    },
    {
      "mark": {"type": "rule", "color": "#ff9a56", "strokeWidth": 2},
      "encoding": {
        "y": {
          "aggregate": "mean",
          "field": "Annual area burnt by wildfires",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "dy": -8,
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#ff9a56"
      },
      "encoding": {
        "x": {"value": 0},
        "y": {
          "aggregate": "mean",
          "field": "Annual area burnt by wildfires",
          "type": "quantitative"
        },
        "text": {"value": "Average"}
      }
    }
  ],
  "config": {
    "background": "#1a0a02",
    "view": {"stroke": "transparent"}
  }
}